//--- export object end ---//
$teamScoreLimit = 5;
exec(objectives);
$Game::missionType = "F&R";
$cdTrack = 10;
$cdPlayMode = 1;

//== Set existing tower turrets to align with a random team
%group = nameToID("MissionGroup\\Towers");
%numObj = Group::objectCount(%group);
for(%j = 0; %j < %numObj; %j++)
{
	%tempObj = Group::getObject(%group, %j);
	if(getObjectType(%tempObj) == "Turret")
	{
		GameBase::setTeam(%tempObj, floor(getRandom() * 1.999));
	}
}
