$MDESC::Type = "Find and Retrieve";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Find and Retrieve" @
         "\n<f1>Planet: <f0> Deus Sanguinius" @
         "\n<f1>Weather: <f0> Clear" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> face off amid the rolling hills of Deus Sanguinius.  The bases are high and the flags are scattered throughout the battlefield, both in the sky and on the ground amid the wreckage of lost bases.  The team who finds and keeps the most flags shall be the victor!";
