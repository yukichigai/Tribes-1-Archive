$MDESC::Type = "Find and Retrieve";
$MDESC::Text = "<s3><f1>Mission Type: <f0> Find and Retrieve" @
         "\n<f1>Planet: <f0> Deus Sanguinius" @
         "\n<f1>Weather: <f0> Clear, bright day with snow" @
         "\n<f1>Time of Day: <f0> Midday" @ 
         "\n<f1># of Teams: <f0> 2" @
         "\n<f1>Modified By: <f0> [FTA]Raindance" @
	 "\n<f1>Modified Again By: <f0> =AWA=Yukichigai" @
         "\n\n<f1>Briefing:<f0> The <vServer::teamName0> and <vServer::teamName1> battle it out on this modified version of Broadside.  There is now a gigantic, floating base in the sky that can be captured, but more importantly the flags are located within.  To reach it, take the elevator that sits between the two original Broadside bases.";